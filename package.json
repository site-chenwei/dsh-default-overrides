{
  "name": "dsh-default-overrides",
  "version": "0.9.1",
  "description": "Prompt, persona and tool overrides for the DSH standard preset.",
  "type": "module",
  "license": "MIT",
  "main": "./scripts/dsh-default-overrides.mjs",
  "exports": {
    ".": "./scripts/dsh-default-overrides.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "scripts/dsh-default-overrides.mjs",
    "cordis.patch.yml",
    "examples/",
    "dsh-default-overrides-migration.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "persona"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check scripts/dsh-default-overrides.mjs && node --check scripts/verify-dsh-default-overrides.mjs && node --check scripts/verify-package.mjs",
    "verify": "node scripts/verify-dsh-default-overrides.mjs",
    "verify:package": "npm run check && node scripts/verify-package.mjs",
    "prepack": "npm run check"
  }
}
